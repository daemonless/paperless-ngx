# Sourced by the init script and every service: paperless 3.3 refuses to start
# without PAPERLESS_SECRET_KEY. Yours wins when set; otherwise one is made on
# first start and kept with the data, so sessions survive a recreate.
key_file=/config/data/.secret_key
if [ -z "${PAPERLESS_SECRET_KEY}" ] || [ "${PAPERLESS_SECRET_KEY}" = "change-me" ]; then
    if [ ! -s "${key_file}" ]; then
        mkdir -p /config/data
        /app/venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(50))' > "${key_file}"
        chmod 600 "${key_file}"
        chown bsd:bsd "${key_file}"
        echo "[paperlessngx] Generated PAPERLESS_SECRET_KEY in ${key_file}"
    fi
    PAPERLESS_SECRET_KEY=$(cat "${key_file}")
fi
export PAPERLESS_SECRET_KEY
