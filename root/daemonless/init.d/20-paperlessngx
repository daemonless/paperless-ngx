#!/bin/sh
# Create directories for paperless-ngx

# Ensure directories exist and have correct ownership
mkdir -p /config/consume /config/data /config/media
chown -R bsd:bsd /config

. /etc/paperless-secret-key

# Run a DB migration to make sure the database is initialized
# and updated to the latest schema. The venv's python, not `uv run`: uv
# wants /app/wheels, which the build prunes, and the migration never ran.
echo [paperlessngx-migration] Running DB migration
(cd /app/src/src && dsu bsd /app/venv/bin/python manage.py migrate) || exit 1

# Create superuser if env variable is defined
if [ "x${PAPERLESS_ADMIN_USER}" != "x" ]; then
  (cd /app/src/src && dsu bsd /app/venv/bin/python manage.py manage_superuser) || exit 1

  echo "[paperlessngx-superuser] Superuser creation done"

else
  echo "[paperlessngx-superuser] Not creating superuser"
fi
