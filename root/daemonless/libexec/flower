#!/bin/sh
# Paperless-ngx flower rcd unit

readonly log_prefix="[flower]"

echo "${log_prefix} Starting flower..."

HOME=/config; export HOME
LANG=en_US.UTF-8; export LANG
. /etc/paperless-secret-key

# Standard start command for paperless-ngx
if [ "x${PAPERLESS_ENABLE_FLOWER}" != "x" ]; then
    # Small delay to allow celery to be up first
    echo "${log_prefix} Starting flower in 5s"
    sleep 5
    cd /app/src/src
    exec dsu bsd \
         /app/venv/bin/python -m celery --app paperless flower --url-prefix=flower --loglevel INFO
else
    echo "${log_prefix} Not starting flower"
    # Disabled: idle (an exit would be restarted). FreeBSD sleep has no "infinity".
    exec sleep 2147483647
fi
