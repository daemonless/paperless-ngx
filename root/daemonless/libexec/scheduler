#!/bin/sh
# Paperless-ngx scheduler rcd unit

readonly log_prefix="[scheduler]"

echo "${log_prefix} Starting schduler..."

HOME=/config; export HOME
LANG=en_US.UTF-8; export LANG
. /etc/paperless-secret-key

# Standard start command for scheduler
cd /app/src/src
exec dsu bsd \
     /app/venv/bin/python -m celery --app paperless beat --loglevel DEBUG -s /config/data/celerybeat-schedule
