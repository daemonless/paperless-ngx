#!/bin/sh
# Paperless-ngx rcd unit

readonly log_prefix="[paperlessngx]"

echo "${log_prefix} Starting paperless-ngx..."

HOME=/config; export HOME
LANG=en_US.UTF-8; export LANG
. /etc/paperless-secret-key

# Standard start command for paperless-ngx
cd /app/src/src
exec dsu bsd \
     /app/venv/bin/python -m granian \
     --interface asginl --ws --loop uvloop paperless.asgi:application
