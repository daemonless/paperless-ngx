FROM ghcr.io/daemonless/base:${BASE_VERSION}


# Use local package cache
ARG PKG_CACHE_URL
RUN <<CMD_EOF
### todo: exit if PKG_CACHE_URL is not set
mkdir -p /usr/local/etc/pkg/repos || true
cat <<EOF >/usr/local/etc/pkg/repos/FreeBSD.conf
FreeBSD-Ports: {
  url: "http://${PKG_CACHE_URL}/\${ABI}/latest",
  mirror_type: "none",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: yes
}
EOF
CMD_EOF

RUN <<CMD_EOF
pkg update && pkg install -y uv git zip yq \
  py312-pip \
  py312-numpy \
  py312-scipy \
  py312-sqlite-vec \
  py312-pytorch \
  py312-twisted \
  py312-pygments \
  py312-psycopg \
  py312-psycopg-c \
  py312-networkx \
  py312-pdfminer-six \
  py312-llama-index-core \
  py312-nltk \
  py312-Babel \
  yq libxslt \
  mariadb118-client postgresql18-client openblas libheif poppler-utils \
  py312-psycopg-pool \
  py312-redis5 \
  py312-hiredis \
  py312-zope.interface \
  py312-granian \
  py312-uvloop \
  py312-zxing-cpp \
  py312-celery \
  py312-msgpack \
  py312-pyyaml \
  py312-regex \
  py312-jiter \
  py312-safetensors \
  py312-greenlet \
  py312-time-machine \
  py312-cffi \
  py312-zstandard \
  py312-cryptography \
  py312-brotli \
  py312-ujson \
  py312-aiohttp \
  py312-ruff \
  py312-lxml \
  py312-pillow-heif \
  py312-scikit-learn \
  py312-autobahn \
  py312-prek \
  py312-scipy \
  py312-numpy \
  py312-pillow \
  py312-rapidfuzz \
  py312-zensical \
  py312-ninja \
  py312-pywavelets \
  py312-uharfbuzz \
  py312-langdetect \
  py312-tokenizers \
  py312-tiktoken \
  py312-tornado \
  py312-pydantic2 \
  py312-rpds-py \
  py312-hf-xet \
  py312-watchfiles \
  py312-django52 \
  py312-django-compression-middleware \
  py312-pdftotext \
  tesseract \
  ghostscript10 \
  ImageMagick7-nox11 \
  unpaper \
  pngquant
pkg clean -ay
rm -rf /var/cache/pkg/* /var/db/pkg/repos/*
CMD_EOF

# Copy artifacts from build stage
COPY --from=builder /src/qpdf/build/qpdf*.tar.xz /tmp/qpdf.tar.xz
COPY --from=builder /wheels /app/wheels

RUN <<CMD_EOF
tar xJvf /tmp/qpdf.tar.xz -C /usr/local --strip-components 1
ldconfig -m /usr/local/lib
CMD_EOF

ARG UPSTREAM_URL
ARG UPSTREAM_JQ
ARG TARBALL_JQ

ENV UV_PROJECT_ENVIRONMENT=/app/venv \
    UV_LINK_MODE=copy

# Fetch and extract source tarball
RUN <<CMD_EOF
export TARBALL=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${TARBALL_JQ}")
fetch -qo /tmp/paperless.tar.xz "${TARBALL}"
mkdir -m 0755 -p /app/src
tar -C /app/src -xJf /tmp/paperless.tar.xz --strip-components 1
rm -f /tmp/paperless.tar.xz
CMD_EOF

# Setup bsd user for build
RUN /etc/cont-init.d/10-usermod

# Add python3 symlink
RUN cd /usr/local/bin && ln -sf python3.12 python3 && chmod -h a+rx python3

WORKDIR /app/src

RUN <<CMD_EOF
export FC=/usr/local/bin/gfortran14
export CMAKE_EXECUTABLE=/usr/local/bin/cmake
export SKBUILD_CMAKE_VERSION=""
export SKBUILD_NINJA_VERSION=""
export CMAKE_BUILD_PARALLEL_LEVEL=$(sysctl -n hw.ncpu)

tomlq -t -i --arg new "sys_platform == 'freebsd15'" '.tool.uv.environments += [$new]' pyproject.toml
tomlq -t -i 'del(.project.dependencies[] | select(test("^(pypdfium2|sqlite-vec|torch)"))) ' pyproject.toml
tomlq -t -i '.tool.uv."exclude-dependencies" += ["pypdfium2","sqlite-vec","torch"]' pyproject.toml
tomlq -t -i '.project.dependencies += ["granian[uvloop]~=2.7.6"]' pyproject.toml
tomlq -t -i '
  .tool.uv."find-links" += ["/app/wheels/"]
  | .tool.uv."no-build-package" += ["tantivy"]
' pyproject.toml
tomlq -t -i 'del(.tool.uv.sources.torch)' pyproject.toml
# tomlq -t -i '.tool.uv."no-build-package" += ["pypdfium2","sqlite-vec","pytorch"]' pyproject.toml
# Replace versions
tomlq -t -i '
  .project.dependencies
  |= map(
    if test("^celery")                   then "celery~=5.3.1"
    elif test("^ocrmypdf")               then "ocrmypdf>=17.11.0"
    else . end
  )
# Remove dependencies on some transient dependencies
' pyproject.toml
# Replace versions
tomlq -t -i '
  .project."optional-dependencies".postgres
  |= map(
    if   test("^psycopg\\[c,pool\\]==")  then "psycopg[c,pool]~=3.3.0"
    elif test("^psycopg-c==")            then "psycopg-c~=3.3.0"
    elif test("^psycopg-pool==")         then "psycopg-pool~=3.3.1"
    elif test("^redis\\[hiredis\\]")     then "redis[hiredis]~=5.3.1"
    else . end
  )
# Remove dependencies on some transient dependencies
' pyproject.toml
tomlq -t -i '
  .tool.uv."exclude-dependencies" += ["hiredis","msgpack","pyyaml","regex","jiter","safetensors","greenlet",
    "zxing-cpp","time-machine","cffi","zstandard","cryptography","brotli","ujson","aiohttp","ruff","pi-heif",
    "lxml","scikit-learn","autobahn","prek","scipy","numpy","pillow","rapidfuzz","zensical","ninja","uvloop",
    "granian","pywavelets","uharfbuzz","langdetect","tokenizers","tiktoken","tornado","pydantic",
    "llama-index-core","rpds-py","hf-xet","watchfiles"]
' pyproject.toml
uv venv --system-site-packages || exit 1
uv lock --upgrade-package ocrmypdf --upgrade-package pikepdf --upgrade-package uharfbuzz --upgrade-package tantivy
uv sync || exit 1
uv export -o requirements.txt || exit 1
uv cache clean
CMD_EOF


ARG FREEBSD_ARCH=amd64

LABEL org.opencontainers.image.title="Paperless-ngx" \
      org.opencontainers.image.description="A community-supported open-source document management system that transforms your physical documents into a searchable online archive so you can keep, well, less paper." \
      org.opencontainers.image.source="https://github.com/daemonless/paperless-ngx" \
      org.opencontainers.image.url="https://paperless-ngx.org/" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Utilities" \
{%- if ports %}
      io.daemonless.port="{{ ports[0].target }}" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.packages="${PACKAGES}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}"
      
# Update to latest patch level and install PAM
RUN <<CMD_EOF
pkg update -r FreeBSD-base
pkg upgrade -y -r FreeBSD-base
pkg install -y -r FreeBSD-base FreeBSD-pam
pkg clean -ay
rm -rf /var/cache/pkg/* /var/db/pkg/repos/*
CMD_EOF

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Ignore warning from Whitenoise about async iterators
    PYTHONWARNINGS="ignore:::django.http.response:517" \
    PNGX_CONTAINERIZED=1 \
    # https://docs.astral.sh/uv/reference/settings/#link-mode
    UV_LINK_MODE=copy \
    # PYTHONPATH=/app/.local/lib/python3.12/site-packages \
    NLTK_DATA=/app/nltk_data \
    UV_PROJECT_ENVIRONMENT=/app/venv \
    UV_CACHE_DIR=/app/.cache \
    UV_FROZEN=1

# Install NLTK data
RUN <<CMD_EOF
find /usr/local -type d -exec chmod 755 {} +
mkdir -p /app/nltk_data
chown -R bsd:bsd /app
echo "Installing NLTK_DATA ..."
su -m bsd -c "cd /app/src && /app/venv/bin/python  -m nltk.downloader -d /app/nltk_data snowball_data stopwords punkt_tab"
CMD_EOF

ENV PAPERLESS_NLTK_DIR=/app/nltk_data \
    PAPERLESS_ENABLE_NLTK=true \
    PAPERLESS_MEDIA_ROOT=/config/media \
    PAPERLESS_DATA_DIR=/config/data \
    PAPERLESS_CONSUMPTION_DIR=/config/consume \
    PAPERLESS_THUMBNAIL_FONT_NAME=/usr/local/share/fonts/Liberation/LiberationSerif-Regular.ttf \
    PAPERLESS_ENABLE_FLOWER=true \
    GRANIAN_HOST=0.0.0.0

# Extract version information
RUN su -m bsd -c "cd /app/src/src && uv run python -c 'from paperless import version; print(version.__full_version_str__)' > /app/version"

# Copy root filesystem
COPY root/ /

## Set permissions
RUN chmod +x /etc/services.d/*/run /etc/cont-init.d/* /healthz 2>/dev/null || true

## Temporary fix for regex timeout
RUN <<CMD_EOF
sed -i "" 's/MATCH_REGEX_TIMEOUT_SECONDS", 0.1/MATCH_REGEX_TIMEOUT_SECONDS", 1.0/' /app/src/src/documents/regex.py
CMD_EOF

# --- Expose (Injected by Generator) ---
{%- if ports %}
EXPOSE {{ ports | map(attribute='target') | join(' ') }}
{%- endif %}

# --- Volumes (Injected by Generator) ---
{%- if volumes %}
VOLUME {{ volumes | map(attribute='path') | join(' ') }}
{%- endif %}
