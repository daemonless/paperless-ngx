ARG BASE_VERSION=15

ARG UPSTREAM_URL="https://api.github.com/repos/paperless-ngx/paperless-ngx/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
ARG TARBALL_JQ=".assets[0].browser_download_url"

FROM ghcr.io/daemonless/base:${BASE_VERSION} AS builder

# Use local package cache
ARG PKG_CACHE_URL
RUN <<CMD_EOF
### todo: exit if PKG_CACHE_URL is not set
mkdir -p /usr/local/etc/pkg/repos || true
cat <<EOF >/usr/local/etc/pkg/repos/FreeBSD.conf
FreeBSD-Ports: {
  url: "http://${PKG_CACHE_URL}/\${ABI}/latest",
  mirror_type: "none",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: yes
}
EOF
CMD_EOF

# Install build tools
RUN <<CMD_EOF
pkg update -r FreeBSD-base && pkg install -r FreeBSD-base -y FreeBSD-set-devel
pkg install -y cmake git py312-pip rust
pkg clean -ay
rm -rf /var/cache/pkg/* /var/db/pkg/repos/*
CMD_EOF

# Install build dependencies
RUN <<CMD_EOF
pkg install -y jpeg-turbo pngquant
pkg clean -ay
rm -rf /var/cache/pkg/* /var/db/pkg/repos/*
CMD_EOF

# Build libqpdf
RUN <<CMD_EOF
cat > /tmp/freebsd-toolchain.cmake <<'EOF'
set(CMAKE_C_FLAGS_INIT "-ftls-model=initial-exec")
set(CMAKE_CXX_FLAGS_INIT "-ftls-model=initial-exec -I/usr/local/include")
EOF

mkdir src && cd src
git clone https://github.com/qpdf/qpdf.git --branch v12.4.1
cd qpdf
export CFLAGS="-ftls-model=initial-exec"
export CXXFLAGS="-ftls-model=initial-exec"
cmake -S . -B build \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr/local \
  -DCMAKE_BUILD_PARALLEL_LEVEL=$(sysctl -n hw.ncpu) \
  -DCMAKE_TOOLCHAIN_FILE=/tmp/freebsd-toolchain.cmake

cmake --build build --parallel $(sysctl -n hw.ncpu)
cmake --install build

ldconfig -m /usr/local/lib

cd build
cpack -G TXZ

# Cleanup to save space
cd ..
rm -fr qpdf
CMD_EOF

# Build pikepdf wheel
RUN <<CMD_EOF
cd /
mkdir /wheels

export CFLAGS="-ftls-model=initial-exec"
export CXXFLAGS="-ftls-model=initial-exec -I/usr/local/include"
export LDFLAGS="-L/usr/local/lib"
export CMAKE_BUILD_PARALLEL_LEVEL=$(sysctl -n hw.ncpu)
export CMAKE_ARGS="-DCMAKE_C_FLAGS=-ftls-model=initial-exec -DCMAKE_CXX_FLAGS=-ftls-model=initial-exec"
pip wheel --no-deps --wheel-dir /wheels/ \
  -Ccmake.define.CMAKE_TOOLCHAIN_FILE=/tmp/freebsd-toolchain.cmake \
  pikepdf

version=$(ls -1 /wheels/pikepdf*.whl  | sed -E 's/.*-([0-9]+\.[0-9]+\.[0-9]+)-.*/\1/')
mv /wheels/pikepdf*.whl /wheels/pikepdf-${version}-py3-none-any.whl 

# Cleanup to save space
rm -fr /.cache
CMD_EOF

# Build uharfbuzz wheel
RUN <<CMD_EOF
cd /

export CFLAGS="-ftls-model=initial-exec"
export CXXFLAGS="-ftls-model=initial-exec -I/usr/local/include"
export LDFLAGS="-L/usr/local/lib"
export CMAKE_BUILD_PARALLEL_LEVEL=$(sysctl -n hw.ncpu)
export CMAKE_ARGS="-DCMAKE_C_FLAGS=-ftls-model=initial-exec -DCMAKE_CXX_FLAGS=-ftls-model=initial-exec"
pip wheel --wheel-dir wheels/ \
  -Ccmake.define.CMAKE_TOOLCHAIN_FILE=/tmp/freebsd-toolchain.cmake \
  uharfbuzz

version=$(ls -1 /wheels/uharfbuzz*.whl  | sed -E 's/.*-([0-9]+\.[0-9]+\.[0-9]+)-.*/\1/')
mv /wheels/uharfbuzz*.whl /wheels/uharfbuzz-${version}-py3-none-any.whl 

# Build ocrmypdf wheel
rm -fr /.cache
CMD_EOF

RUN <<CMD_EOF
cd /

export CFLAGS="-ftls-model=initial-exec"
export CXXFLAGS="-ftls-model=initial-exec -I/usr/local/include"
export LDFLAGS="-L/usr/local/lib"
export CMAKE_BUILD_PARALLEL_LEVEL=$(sysctl -n hw.ncpu)
export CMAKE_ARGS="-DCMAKE_C_FLAGS=-ftls-model=initial-exec -DCMAKE_CXX_FLAGS=-ftls-model=initial-exec"
pip wheel --no-deps --wheel-dir wheels/ ocrmypdf

version=$(ls -1 /wheels/ocrmypdf*.whl  | sed -E 's/.*-([0-9]+\.[0-9]+\.[0-9]+)-.*/\1/')
mv /wheels/ocrmypdf*.whl /wheels/ocrmypdf-${version}-py3-none-any.whl 

# Build ocrmypdf wheel
rm -fr /.cache
CMD_EOF

# Build tantivy wheel
RUN <<CMD_EOF
cd /src

export CFLAGS="-ftls-model=initial-exec"
export CXXFLAGS="-ftls-model=initial-exec -I/usr/local/include"
export CMAKE_ARGS="-DCMAKE_C_FLAGS=-ftls-model=initial-exec -DCMAKE_CXX_FLAGS=-ftls-model=initial-exec"
python3.12 -m venv /tmp/venv-tantivy
. /tmp/venv-tantivy/bin/activate

pip install maturin
git clone https://github.com/quickwit-oss/tantivy-py.git --branch 0.26.0
cd tantivy-py
maturin build --release

mv target/wheels/tantivy-*.whl /wheels/tantivy-0.26.0-py3-none-any.whl

# Build ocrmypdf wheel
rm -fr /.cache /.cargo
CMD_EOF

